# Demo passcode gate ------------------------------------------------------
# The demo build ships with a built-in SHA-256 digest so no passcode string
# lives in the bundle. Override the expected digest here if you want a
# different local passcode (see src/lib/auth/demoProvider.ts).
# VITE_DEMO_PASSCODE_SHA256=

# Supabase (drop-in replacement for the demo passcode gate) ---------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Firebase (alternative auth backend) ------------------------------------
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
